{
  "version": 4,
  "train": "community",
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial script."
  },
  "requirements": {
    "locations": ["ApplicationsPerformance", "Shows", "Downloads"],
    "specifications": ["1CORE", "1GBRAM", "500MB"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30113]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)/sonarr/config",
      "owner": { "user": "apps", "group": "apps" },
      "snapshot": { "id": "config" }
    }
  ],
  "app_values": {
    "TZ": "$TIMEZONE",
    "run_as": {
      "user": 568,
      "group": 568
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30113
      }
    },
    "storage": {
      "config": {
        "type": "host_path",
        "host_path_config": {
          "path": "$LOCATION(ApplicationsPerformance)/sonarr/config",
          "acl_enable": false
        }
      },
      "additional_storage": [
        {
          "type": "host_path",
          "read_only": false,
          "mount_path": "/tv",
          "host_path_config": { "path": "$LOCATION(Shows)", "acl_enable": false }
        },
        {
          "type": "host_path",
          "read_only": false,
          "mount_path": "/downloads",
          "host_path_config": { "path": "$LOCATION(Downloads)", "acl_enable": false }
        }
      ]
    },
    "resources": {
      "limits": {
        "cpus": "$CPUS(2)",
        "memory": "$MEMORY(10, 1024)"
      }
    }
  }
}
