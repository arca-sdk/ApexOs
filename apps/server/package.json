{
  "name": "@hearth/server",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "HEARTH_DEMO=${HEARTH_DEMO:-1} tsx watch src/index.ts",
    "demo": "HEARTH_DEMO=1 tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:fastify --external:'@fastify/*' --external:zod --external:bufferutil --external:utf-8-validate --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "validate-scripts": "tsx src/scripts/validate-scripts.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@hearth/api-types": "workspace:*",
    "@hearth/shared": "workspace:*",
    "@hearth/truenas-client": "workspace:*",
    "fastify": "5.12.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@hearth/mock-truenas": "workspace:*",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
